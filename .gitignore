# Source documents are fetched locally, never committed: several are
# copyrighted (IAEA, NEI) or licensed (EUR).
corpus/raw/*
!corpus/raw/.gitkeep

# Build artefacts — rebuild with scripts/build_db.py
db/
export/

# web/aircraft-impact.html is generated but IS committed: it is the
# install-free deliverable, and it carries only the curated layer.

__pycache__/
*.pyc
.venv/
